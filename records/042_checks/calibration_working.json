        "start_line": 40,
        "end_line": 94,
        "original_text": "    - name: stg_tiktok_ads__advertiser\n      description: \"Cleaned advertiser master data with normalized contact fields and type-safe numeric conversions.\"\n      source_table: raw.tiktok_advertiser_data\n      columns:\n        - name: source_relation\n          data_type: VARCHAR\n        - name: advertiser_id\n          data_type: VARCHAR\n        - name: address\n          data_type: VARCHAR\n        - name: balance\n          data_type: DOUBLE\n          validation_rules:\n            - rule: \"balance is numeric\"\n              on_failure: nullify_field\n        - name: company\n          data_type: VARCHAR\n        - name: contacter\n          data_type: VARCHAR\n        - name: country\n          data_type: VARCHAR\n        - name: currency\n          data_type: VARCHAR\n        - name: description\n          data_type: VARCHAR\n        - name: email\n          data_type: VARCHAR\n          validation_rules:\n            - rule: \"email normalized to lowercase and trimmed\"\n              on_failure: correct\n            - rule: \"email matches standard pattern (local@domain.tld)\"\n              on_failure: nullify_field\n        - name: industry\n          data_type: VARCHAR\n        - name: language\n          data_type: VARCHAR\n        - name: advertiser_name\n          data_type: VARCHAR\n          validation_rules:\n            - rule: \"name trimmed\"\n              on_failure: correct\n            - rule: \"name length between 3 and 100 and only alphanumeric plus spaces\"\n              on_failure: nullify_field\n        - name: cellphone_number\n          data_type: VARCHAR\n          validation_rules:\n            - rule: \"strip non-digit characters except leading '+'\"\n              on_failure: correct\n            - rule: \"must conform to E.164 format\"\n              on_failure: nullify_field\n        - name: telephone_number\n          data_type: VARCHAR\n        - name: timezone\n          data_type: VARCHAR\n\n"
      }
    ]

          "text": "{\n  \"premises\": [\n    {\n      \"statement\": \"The greatest version value within each template ID identifies its most recent version.\",\n      \"about\": \"requirement\",\n      \"target\": \"staging.stg_marketo__email_template_history.is_most_recent_version\",\n      \"evidence_of_dependence\": \"(version = MAX(version) OVER (PARTITION BY id)) AS is_most_recent_version\",\n      \"alternative\": null,\n      \"importance\": 3,\n      \"reason\": \"The contract requires the flag but does not establish how recency is determined, which can affect current-template selection.\",\n      \"updates\": null\n    },\n    {\n      \"statement\": \"Ordering the raw version values produces the same maximum as ordering their contracted DOUBLE representations.\",\n      \"about\": \"data\",\n      \"target\": \"staging.stg_marketo__email_template_history.is_most_recent_version\",\n      \"evidence_of_dependence\": \"version = MAX(version) OVER (PARTITION BY id)\",\n      \"alternative\": null,\n      \"importance\": 2,\n      \"reason\": \"If raw versions are strings, their maximum can differ from the numeric maximum used to identify the latest version.\",\n      \"updates\": null\n    }\n  ],\n  \"fewer\": [\n    {\n      \"target\": \"staging.stg_marketo__email_template_history\",\n      \"count\": 2,\n      \"reason\": \"The new recency calculation introduces these two unestablished premises; email nullification follows the contract, and previously recorded omissions are not repeated.\"\n    },\n    {\n      \"target\": \"staging.stg_marketo__campaigns\",\n      \"count\": 0,\n      \"reason\": \"Both changes directly implement the documented program-ID nullification and active-flag default, resolving rather than introducing the previously recorded premises.\"\n    },\n    {\n      \"target\": \"staging.stg_marketo__lead\",\n      \"count\": 0,\n      \"reason\": \"The change permits null optional names while preserving their non-null validation rules;
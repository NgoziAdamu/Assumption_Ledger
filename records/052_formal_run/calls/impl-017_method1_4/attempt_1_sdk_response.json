          "text": "{\n  \"premises\": [\n    {\n      \"statement\": \"The required days_since_created metric uses the current execution timestamp rather than midnight on the current date.\",\n      \"about\": \"requirement\",\n      \"target\": \"mart.greenhouse__job_enhanced.days_since_created\",\n      \"evidence_of_dependence\": \"DATE_DIFF('microsecond', created_at, CURRENT_TIMESTAMP) / 86400000000.0 AS days_since_created\",\n      \"alternative\": \"The contract specifies \\\"the number of days between the current date and created_at\\\"; fractional days can arise from the time component of created_at even when the endpoint is midnight.\",\n      \"importance\": 3,\n      \"reason\": \"Using the execution time changes every non-null age by the fraction of the current day already elapsed.\",\n      \"updates\": null\n    },\n    {\n      \"statement\": \"Casting prospect to VARCHAR before comparing it with the case-sensitive literal 'True' implements the contract's intended prospect-counting rule.\",\n      \"about\": \"requirement\",\n      \"target\": \"mart.greenhouse__job_enhanced.count_prospect_applications\",\n      \"evidence_of_dependence\": \"COUNT(*) FILTER (WHERE prospect::VARCHAR = 'True')::BIGINT AS count_prospect_applications\",\n      \"alternative\": \"The upstream contract declares prospect as BOOLEAN, while the job contract says \\\"prospect equals the string 'True'\\\"; comparing the Boolean directly with that literal can differ from first rendering it as DuckDB's lowercase Boolean text.\",\n      \"importance\": 3,\n      \"reason\": \"The explicit text conversion can exclude every true Boolean prospect from the count.\",\n      \"updates\": null\n    }\n  ],\n  \"fewer\": [\n    {\n      \"target\": \"mart.greenhouse__interview_enhanced\",\n      \"count\": 0,\n      \"reason\": \"The shown joins, substring test, and pass-through fields follow the contract; the application-join multiplicity concern is already covered by recorded premise c3-3.\"\n    },\n    {\n      \"target\": \"mart.greenhouse__application_enhanced\",\n      \"count\": 0,\n      \"reason\": \"The aggregation, distinct counts, latest timestamp, left join, and defaults are explicitly specified, with no additional unsupported premise identified.\"\n    },\n    {\n      \"target\": \"mart.greenhouse__interview_scorecard_detail\",\n      \"count\": 0,\n      \"reason\": \"The attribute join, field provenance, duplicate preservation, and null-propagating key construction are explicitly specified.\"\n    },\n    {\n      \"target\": \"mart.greenhouse__job_enhanced\",\n      \"count\": 2,\n      \"reason\": \"Only the time endpoint and Boolean-to-text comparison introduce new unsupported interpretations; the remaining shown metrics follow explicit contract rules or rely on previously recorded upstream premises.\"\n    }\n  ]\n}",

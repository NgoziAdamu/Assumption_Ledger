          "text": "{\n  \"premises\": [\n    {\n      \"statement\": \"Counting a qualifying scorecard once for every scheduled interview joined to its application is the intended interpretation of positive_interviews.\",\n      \"about\": \"requirement\",\n      \"target\": \"mart.greenhouse__candidate_summary\",\n      \"evidence_of_dependence\": \"LEFT JOIN staging.stg_greenhouse__scheduled_interview AS si ON a.application_id = si.application_id ... LEFT JOIN staging.stg_greenhouse__scorecard AS sc ON a.application_id = sc.application_id; COUNT(*) FILTER (WHERE sc.overall_recommendation IN ('strong_yes', 'yes'))\",\n      \"alternative\": \"The contract says \\\"positive_interviews as the count of scorecards\\\" and \\\"counts all qualifying scorecards\\\", which could mean counting each scorecard row once rather than once per matching scheduled interview, although its prescribed joins support the agent's reading.\",\n      \"importance\": 4,\n      \"reason\": \"Join multiplication can substantially change positive-interview totals, success rates, and the weighting of average scores.\",\n      \"updates\": null\n    },\n    {\n      \"statement\": \"For each application_id, no two matching application_enhanced rows have identical values for all application attributes selected by the history model.\",\n      \"about\": \"data\",\n      \"target\": \"mart.greenhouse__application_history\",\n      \"evidence_of_dependence\": \"INNER JOIN mart.greenhouse__application_enhanced AS app ON history.application_id = app.application_id ... COUNT(activity.activity_id)::HUGEINT AS count_activities_in_stage ... GROUP BY ALL\",\n      \"alternative\": \"The application_enhanced contract explicitly permits duplicates: \\\"If multiple application rows share the same application_id, each receives the same joined metrics.\\\" Identical selected attributes would cause GROUP BY ALL to merge their joined activity rows.\",\n      \"importance\": 4,\n      \"reason\": \"Matching duplicate application projections would multiply activity counts before being collapsed into a single interval row.\",\n      \"updates\": \"c3-3\"\n    }\n  ],\n  \"fewer\": [\n    {\n      \"target\": \"mart.greenhouse__application_history\",\n      \"count\": 1,\n      \"reason\": \"The remaining interval construction, joins, time arithmetic, and activity boundaries follow explicit contract instructions; upstream staging assumptions are already recorded.\"\n    },\n    {\n      \"target\": \"mart.greenhouse__candidate_summary\",\n      \"count\": 1,\n      \"reason\": \"Apart from the scorecard-counting ambiguity, the aggregates, classifications, defaults, filtering, and ordering are explicitly specified; upstream staging assumptions are already recorded.\"\n    }\n  ]\n}"
        }

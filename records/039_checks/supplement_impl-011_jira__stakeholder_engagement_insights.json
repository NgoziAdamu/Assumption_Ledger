      "sql": "with active as (select * from staging.stg_jira__user where is_active=true), acts as (select user_id,count(distinct i.issue_id) filter(where i.reporter_user_id=user_id) issues_reported,count(distinct i.issue_id) filter(where i.assignee_user_id=user_id) issues_assigned,count(distinct i.project_id) filter(where i.reporter_user_id=user_id or i.assignee_user_id=user_id) total_projects_involved from active u left join staging.stg_jira__issue i on u.user_id in (i.reporter_user_id,i.assignee_user_id) group by user_id), cm as (select author_user_id,count(*) total_comments from staging.stg_jira__comment group by author_user_id) select u.user_id stakeholder_id,u.user_display_name,coalesce(a.issues_reported,0)::bigint issues_reported,coalesce(a.issues_assigned,0)::bigint issues_assigned,coalesce(cm.total_comments,0)::bigint total_comments_authored,coalesce(a.total_projects_involved,0)::bigint total_projects_involved,0::bigint direct_network_connections,'Slow' response_pattern_type,null::double avg_outbound_influence_strength,null::decimal(38,2) total_outbound_influence,null::decimal(38,2) total_inbound_influence,coalesce(a.total_projects_involved,0)::bigint cross_functional_projects,least(25,coalesce(a.total_projects_involved,0)*8)::bigint engagement_breadth_score,null::double engagement_depth_score,0::integer engagement_quality_score,0::integer engagement_impact_score,null::double total_engagement_score,'Standard Participant' stakeholder_archetype,'Minimal' influence_level,30::integer strategic_value_score,'Healthy Engagement' engagement_risk_status,'Standard Engagement' recommended_engagement_strategy,'Advanced Leadership Opportunities' development_opportunity from active u left join acts a using(user_id) left join cm on u.user_id=cm.author_user_id",
